#!/bin/sh

set -eu

script_dir=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
userspace_dir=$(CDPATH= cd -- "$script_dir/.." && pwd)
neutrino_sysroot=${NEUTRINO_SYSROOT:-"$userspace_dir/build/newlib-pie-sysroot"}
neutrino_target=${NEUTRINO_TARGET:-x86_64-elf}
neutrino_cc=${NEUTRINO_CROSS_CC:-"$neutrino_target-gcc"}
target_root="$neutrino_sysroot/$neutrino_target"
compiler_include=$("$neutrino_cc" -print-file-name=include)

if [ "${1:-}" = "--print-sysroot" ]; then
    printf '%s\n' "$target_root"
    exit 0
fi

compile_only=0
shared_link=0
link_output=
next_is_output=0
for argument in "$@"; do
    if [ "$next_is_output" -eq 1 ]; then
        link_output=$argument
        next_is_output=0
    elif [ "$argument" = "-o" ]; then
        next_is_output=1
    fi
    case "$argument" in
        -c|-E|-S|-M|-MM|--version|--help)
            compile_only=1
            ;;
        # OpenJDK probes C++ precompiled-header support with `-x c++-header`.
        # That produces a compiler artifact, not a runnable Neutrino program,
        # so it must not receive crt0 or the final-link flags below.
        *-header)
            compile_only=1
            ;;
        -shared)
            shared_link=1
            ;;
    esac
done

common_flags="
    -O2
    -ffreestanding
    -fno-builtin
    -fno-stack-protector
    -nostdlib
    -m64
    -mno-red-zone
    -mno-avx
    -mno-avx512f
    -fPIE
"

if [ "$compile_only" -eq 1 ]; then
    # Word splitting is intentional for this fixed, whitespace-only flag list.
    # shellcheck disable=SC2086
    exec "$neutrino_cc" $common_flags \
        -nostdinc \
        -isystem "$neutrino_sysroot/include" \
        -isystem "$target_root/include" \
        -isystem "$compiler_include" \
        "$@"
fi

if [ "$shared_link" -eq 1 ]; then
    # Shared objects intentionally leave libc and Neutrino platform symbols
    # for the executable's exported symbol table. Do not inject crt0 or a
    # second copy of libc into each DSO.
    # shellcheck disable=SC2086
    shared_soname_flag=
    shared_namespace=${NEUTRINO_SHARED_OBJECT_NAMESPACE:-}
    if [ -n "$shared_namespace" ] && [ -n "$link_output" ]; then
        shared_namespace=${shared_namespace%/}
        shared_basename=${link_output##*/}
        shared_soname_flag="-Wl,-soname,$shared_namespace/$shared_basename"
    fi
    exec "$neutrino_cc" $common_flags \
        -nostdinc \
        -isystem "$neutrino_sysroot/include" \
        -isystem "$target_root/include" \
        -isystem "$compiler_include" \
        -L"$target_root/lib" -Wl,-shared,-z,noexecstack \
        "$@" $shared_soname_flag -lgcc
fi

crt0="$target_root/lib/crt0.o"
platform_library="$target_root/lib/libneutrino.a"
libc="$target_root/lib/libc.a"
libm="$target_root/lib/libm.a"
for required_file in "$crt0" "$platform_library" "$libc" "$libm"; do
    if [ ! -f "$required_file" ]; then
        printf 'neutrino-cc: missing %s\n' "$required_file" >&2
        printf 'run: make -C %s newlib-crt\n' "$userspace_dir" >&2
        exit 1
    fi
done

# Word splitting is intentional for this fixed, whitespace-only flag list.
# shellcheck disable=SC2086
exec "$neutrino_cc" $common_flags \
    -nostdinc \
    -isystem "$neutrino_sysroot/include" \
    -isystem "$target_root/include" \
    -isystem "$compiler_include" \
    -pie -Wl,--no-dynamic-linker,-z,noexecstack,-E \
    "$crt0" "$@" \
    -Wl,--start-group "$platform_library" "$libc" "$libm" -lgcc \
    -Wl,--end-group
